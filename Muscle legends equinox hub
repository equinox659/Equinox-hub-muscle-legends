local Window = OrionLib:MakeWindow({Name = "Muscle legends | Equinox hub", HidePremium = false, SaveConfig = true, ConfigFolder = "OrionTest"})

local Tab = Window:MakeTab({
	Name = "Farming",
	Icon = "",
	PremiumOnly = false
})

--[[
Name = <string> - The name of the tab.
Icon = <string> - The icon of the tab.
PremiumOnly = <bool> - Makes the tab accessible to Sirus Premium users only.
]]


local Section = Tab:AddSection({
	Name = "Weight"
})

--[[
Name = <string> - The name of the section.
]]

-- Variable global para controlar si el bucle debe seguir corriendo
local autoRep = false

Tab:AddToggle({
    Name = "Auto Rep (Entrenar)",
    Default = false, -- Empieza apagado
    Callback = function(Value)
        autoRep = Value -- 'Value' será true si se activa, o false si se desactiva
        
        -- Si el usuario activó el switch, iniciamos el bucle en un hilo separado
        if autoRep then
            task.spawn(function()
                local Event = game:GetService("Players").LocalPlayer:FindFirstChild("muscleEvent")
                
                -- El bucle corre MIENTRAS el switch esté encendido y el evento exista
                while autoRep and Event do
                    Event:FireServer("rep")
                    task.wait(0.3) -- Retraso de 0.1 segundos para evitar lag o kick
                end
            end)
        end
    end    
})

--[[
Explicación de las propiedades:
Name = <string> - El texto que aparece al lado del switch.
Default = <boolean> - Define si el switch inicia encendido (true) o apagado (false).
Callback = <function> - La función que se ejecuta cada vez que el usuario presiona el switch.
]]
