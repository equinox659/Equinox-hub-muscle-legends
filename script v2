local function unequipAllPets()
    local petsFolder = lp.player:FindFirstChild("petsFolder")
    if not petsFolder then return end
    for _, folder in ipairs(petsFolder:GetChildren()) do
        if folder:IsA("Folder") then
            for _, pet in ipairs(folder:GetChildren()) do
                pcall(function()
                    services.replicatedstorage.rEvents.equipPetEvent:FireServer("unequipPet", pet)
                end)
            end
        end
    end
    task.wait(0.1)
end

local function equipFarmingPets()
    unequipAllPets()
    local petsFolder = lp.player:FindFirstChild("petsFolder")
    local uniqueFolder = petsFolder and petsFolder:FindFirstChild("Unique")
    if not uniqueFolder then return end

    local omegas, swifts, hounds = {}, {}, {}
    for _, pet in ipairs(uniqueFolder:GetChildren()) do
        if pet.Name == "Omega Overlord" then table.insert(omegas, pet)
        elseif pet.Name == "Swift Samurai" then table.insert(swifts, pet)
        elseif pet.Name == "Powercore Hound" then table.insert(hounds, pet) end
    end

    local equippedCount = 0
    local currentPercent = 0

    for i = #omegas, 1, -1 do
        if equippedCount < rbData.maxSlots and currentPercent < 100 then
            pcall(function() services.replicatedstorage.rEvents.equipPetEvent:FireServer("equipPet", omegas[i]) end)
            currentPercent = currentPercent + 20
            equippedCount = equippedCount + 1
        end
    end
    for i = #swifts, 1, -1 do
        if equippedCount < rbData.maxSlots and currentPercent < 100 then
            pcall(function() services.replicatedstorage.rEvents.equipPetEvent:FireServer("equipPet", swifts[i]) end)
            currentPercent = currentPercent + 15
            equippedCount = equippedCount + 1
        end
    end
    if currentPercent >= 100 then
        for i = #hounds, 1, -1 do
            if equippedCount < rbData.maxSlots then
                pcall(function() services.replicatedstorage.rEvents.equipPetEvent:FireServer("equipPet", hounds[i]) end)
                equippedCount = equippedCount + 1
            end
        end
    end
    for i = #omegas, 1, -1 do
        if equippedCount < rbData.maxSlots then
            pcall(function() services.replicatedstorage.rEvents.equipPetEvent:FireServer("equipPet", omegas[i]) end)
            equippedCount = equippedCount + 1
        end
    end
    for i = #swifts, 1, -1 do
        if equippedCount < rbData.maxSlots then
            pcall(function() services.replicatedstorage.rEvents.equipPetEvent:FireServer("equipPet", swifts[i]) end)
            equippedCount = equippedCount + 1
        end
    end
end

local function equipRebirthPets()
    unequipAllPets()
    local petsFolder = lp.player:FindFirstChild("petsFolder")
    local uniqueFolder = petsFolder and petsFolder:FindFirstChild("Unique")
    if not uniqueFolder then return end

    local hydras, tribals = {}, {}
    for _, pet in ipairs(uniqueFolder:GetChildren()) do
        if pet.Name == "Titanium Hydra" then table.insert(hydras, pet)
        elseif pet.Name == "Tribal Overlord" then table.insert(tribals, pet) end
    end

    local equippedCount = 0
    for i = 1, #hydras do
        if equippedCount < rbData.maxSlots then
            pcall(function() services.replicatedstorage.rEvents.equipPetEvent:FireServer("equipPet", hydras[i]) end)
            equippedCount = equippedCount + 1
        end
    end
    for i = 1, #tribals do
        if equippedCount < rbData.maxSlots then
            pcall(function() services.replicatedstorage.rEvents.equipPetEvent:FireServer("equipPet", tribals[i]) end)
            equippedCount = equippedCount + 1
        end
    end
end

local function performRebirthCycle()
    local strengthTarget = 5000 + rebirths.Value * 2550
    local repsPerBurst = lp.player.MembershipType == Enum.MembershipType.Premium and 6 or 12
    local mEvent = services.muscleEvent

    while rbData.running and strength.Value < strengthTarget do
        autoEquipToolByName("Weight")
        for i = 1, repsPerBurst do
            pcall(function() mEvent:FireServer("rep") end)
        end
        task.wait(0.01)
    end

    if rbData.running and strength.Value >= strengthTarget then
        equipRebirthPets()
        task.wait(0.2)
        local currentRb = rebirths.Value
        local rRemote = services.replicatedstorage:FindFirstChild("rEvents") and services.replicatedstorage.rEvents:FindFirstChild("rebirthRemote")
        if rRemote then
            local timeout = 0
            repeat
                pcall(function() rRemote:InvokeServer("rebirthRequest") end)
                task.wait(0.05)
                timeout = timeout + 0.05
            until rebirths.Value > currentRb or not rbData.running or timeout > 2
        end
    end
end

local function startWorker()
    if rbData.workerActive then return end
    rbData.workerActive = true
    task.spawn(function()
        while rbData.running do
            equipFarmingPets()
            performRebirthCycle()
            task.wait(0.2)
        end
        rbData.workerActive = false
    end)
end

