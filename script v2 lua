local function ObtenerConteoMascotas()
    local listaMascotas = {}
    local petsFolder = game:GetService("Players").LocalPlayer:FindFirstChild("petsFolder")
    
    if petsFolder then
        for _, Categoria in ipairs(petsFolder:GetChildren()) do
            for _, Mascota in ipairs(Categoria:GetChildren()) do
                if Mascota and Mascota:IsA("Instance") then
                    -- 1. Buscamos el nombre real en valores internos por si el juego oculta el .Name
                    local nombreReal = Mascota.Name
                    
                    local valorTipo = Mascota:FindFirstChild("Type") or Mascota:FindFirstChild("PetName") or Mascota:FindFirstChild("Name")
                    if valorTipo and (valorTipo:IsA("StringValue") or valorTipo:IsA("Value")) then
                        nombreReal = valorTipo.Value
                    end
                    
                    -- Guardamos y sumamos en nuestra lista
                    listaMascotas[nombreReal] = (listaMascotas[nombreReal] or 0) + 1
                end
            end
        end
    end
    
    -- Imprime en tu consola F9 el mapa de lo que encontró para que verifiques si leyó algo
    print("--- ESCANEO DE MASCOTAS REALIZADO ---")
    for nombre, cantidad in pairs(listaMascotas) do
        print("Detectado en inventario: " .. tostring(nombre) .. " | Cantidad: " .. tostring(cantidad))
    end
    print("-------------------------------------")
    
    return listaMascotas
end

