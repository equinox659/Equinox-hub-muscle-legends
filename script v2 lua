-- FUNCIÓN DE CONSUMO DIRECTO AL SERVIDOR
local function executeServerConsume(itemName)
    local char = player.Character
    local backpack = player:FindFirstChild("Backpack")
    if not char or not backpack or not muscleEvent then return false end

    local tool = char:FindFirstChild(itemName) or backpack:FindFirstChild(itemName)
    
    if tool then
        -- Forzar equipado rápido en el personaje
        if tool.Parent == backpack then
            tool.Parent = char
            task.wait(0.02)
        end
        
        -- Formatear argumento exacto para el servidor
        local argument = itemName
        if itemName == "Protein Egg" then
            argument = "proteinEgg"
        else
            local firstWord = itemName:match("^(%S+)")
            local restOfName = itemName:sub(#firstWord + 1):gsub("%s+", "")
            argument = firstWord:lower() .. restOfName
        end
        
        -- Enviar petición directa de consumo (Mapeado del descompilado)
        muscleEvent:FireServer(argument, tool)
        return true
    end
    return false
end

-- FUNCIÓN PARA EL BOTÓN DE CANTIDAD EXACTA (CON AUTO-REINICIO AL TERMINAR)
