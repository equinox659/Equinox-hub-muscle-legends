local function performRebirthCycle()
    local strengthTarget = 5000 + rebirths.Value * 2550
    local repsPerBurst = lp.player.MembershipType == Enum.MembershipType.Premium and 6 or 12
    local mEvent = services.muscleEvent

    while rbData.running and strength.Value < strengthTarget do
        autoEquipToolByName("Weight")
        for i = 1, repsPerBurst do
            pcall(function() mEvent:FireServer("rep") end)
        end
        task.wait(0.01)
    end

    if rbData.running and strength.Value >= strengthTarget then
        equipRebirthPets()
        task.wait(0.2)
        local currentRb = rebirths.Value
        local rRemote = services.replicatedstorage:FindFirstChild("rEvents") and services.replicatedstorage.rEvents:FindFirstChild("rebirthRemote")
        if rRemote then
            local timeout = 0
            repeat
                pcall(function() rRemote:InvokeServer("rebirthRequest") end)
                task.wait(0.05)
                timeout = timeout + 0.05
            until rebirths.Value > currentRb or not rbData.running or timeout > 2
        end
    end
end

local function startWorker()
    if rbData.workerActive then return end
    rbData.workerActive = true
    task.spawn(function()
        while rbData.running do
            equipFarmingPets()
            performRebirthCycle()
            task.wait(0.2)
        end
        rbData.workerActive = false
    end)
end

