Tab5:AddSwitch("Player ESP (Wallhack)", function(bool)
    espEnabled = bool
    
    -- Tabla para rastrear los elementos de dibujo asignados a cada jugador
    local tracers = _G.ActiveTracers or {}
    _G.ActiveTracers = tracers
    
    -- Función auxiliar para limpiar los elementos visuales de un jugador
    local function removePlayerESP(player)
        -- Limpiar Tracers
        if tracers[player] then
            if tracers[player].Line then tracers[player].Line:Remove() end
            if tracers[player].Connection then tracers[player].Connection:Disconnect() end
            tracers[player] = nil
        end
        -- Limpiar Texto de Fuerza
        if player.Character and player.Character:FindFirstChild("Head") then
            local textESP = player.Character.Head:FindFirstChild("StrengthESP")
            if textESP then textESP:Destroy() end
        end
        -- Limpiar Cajas (Boxes)
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local box = player.Character.HumanoidRootPart:FindFirstChild("PremiumESP")
            if box then box:Destroy() end
        end
    end

    if espEnabled then
        -- Bucle para las Cajas 3D y el Texto de Fuerza (BillboardGui)
        task.spawn(function()
            while espEnabled do
                for _, p in pairs(game:GetService("Players"):GetPlayers()) do
                    if p ~= game:GetService("Players").LocalPlayer and p.Character then
                        
                        -- 1. CONTROL DE LA CAJA (BOX ESP)
                        if p.Character:FindFirstChild("HumanoidRootPart") and not p.Character.HumanoidRootPart:FindFirstChild("PremiumESP") then
                            local box = Instance.new("BoxHandleAdornment")
                            box.Name, box.Size, box.Color3, box.AlwaysOnTop, box.ZIndex, box.Adornee, box.Parent = "PremiumESP", Vector3.new(4, 6, 4), Color3.fromRGB(0, 255, 255), true, 5, p.Character.HumanoidRootPart, p.Character.HumanoidRootPart
                        end
                        
                        -- 2. CONTROL DEL TEXTO DE FUERZA (STRENGTH ESP)
                        if p.Character:FindFirstChild("Head") and not p.Character.Head:FindFirstChild("StrengthESP") then
                            -- Buscar el valor de fuerza en leaderstats (cubre ambas escrituras comunes: Strength y Strenght)
                            local leaderstats = p:FindFirstChild("leaderstats")
                            local strengthValue = leaderstats and (leaderstats:FindFirstChild("Strength") or leaderstats:FindFirstChild("Strenght"))

                            
                            if strengthValue then
                                local bGui = Instance.new("BillboardGui")
                                bGui.Name = "StrengthESP"
                                bGui.Size = UDim2.new(0, 200, 0, 50)
                                bGui.AlwaysOnTop = true
                                bGui.ExtentsOffset = Vector3.new(0, 3, 0) -- Lo posiciona por encima de la cabeza
                                bGui.Parent = p.Character.Head
                                
                                local tLabel = Instance.new("TextLabel")
                                tLabel.Size = UDim2.new(1, 0, 1, 0)
                                tLabel.BackgroundTransparency = 1
                                tLabel.TextColor3 = Color3.fromRGB(0, 255, 255)
                                tLabel.TextStrokeTransparency = 0 -- Borde negro para que sea legible en cualquier fondo
                                tLabel.Font = Enum.Font.SourceSansBold
                                tLabel.TextSize = 14
                                tLabel.Parent = bGui
                                
                                -- Mantener el texto actualizado si su fuerza cambia en la partida
                                tLabel.Text = p.Name .. " | Fuerza: " .. tostring(strengthValue.Value)
                                strengthValue.Changed:Connect(function(newVal)
                                    if bGui and tLabel then
                                        tLabel.Text = p.Name .. " | Fuerza: " .. tostring(newVal)
                                    end
                                end)
                            end
                        end
                        
                    end
                end
                task.wait(2)
            end
        end)

        -- Sistema dinámico para los Tracers (Líneas 2D)
        task.spawn(function()
            local camera = workspace.CurrentCamera
            local playersService = game:GetService("Players")
            local localPlayer = playersService.LocalPlayer

            local function createTracer(p)
                if p == localPlayer or tracers[p] then return end

                local line = Drawing.new("Line")
                line.Color = Color3.fromRGB(0, 255, 255)
                line.Thickness = 1.5
                line.Transparency = 1
                line.Visible = false

                local connection
                connection = game:GetService("RunService").RenderStepped:Connect(function()
                    if not espEnabled then
                        removePlayerESP(p)
                        return
                    end

                    if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local hrp = p.Character.HumanoidRootPart
                        local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)

                        if onScreen then
                            line.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                            line.To = Vector2.new(screenPos.X, screenPos.Y)
                            line.Visible = true
                        else
                            line.Visible = false
                        end
                    else
                        line.Visible = false
                    end
                end)

                tracers[p] = {Line = line, Connection = connection}
            end

            for _, p in pairs(playersService:GetPlayers()) do createTracer(p) end
            local playerAddedConn = playersService.PlayerAdded:Connect(createTracer)
            local playerRemovingConn = playersService.PlayerRemoving:Connect(removePlayerESP)

            tracers["_SystemConnections"] = {playerAddedConn, playerRemovingConn}
        end)

    else
        -- LIMPIEZA TOTAL AL DESACTIVAR
        if tracers["_SystemConnections"] then
            for _, conn in pairs(tracers["_SystemConnections"]) do conn:Disconnect() end
        end

        for _, p in pairs(game:GetService("Players"):GetPlayers()) do
            removePlayerESP(p)
        end
        _G.ActiveTracers = nil
    end
end)



