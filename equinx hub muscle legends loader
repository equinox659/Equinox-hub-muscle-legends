local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/jensonhirst/Orion/main/source')))()

-- ====================================================================
-- CONFIGURACIÓN DEL SISTEMA PREMIUM
-- ====================================================================
local PremiumUsers = {
    [game:GetService("Players").LocalPlayer.UserId] = false, -- Cambiado a false para que pruebes el bloqueo en ti mismo
    [12345678] = true, -- ID de tu amigo 1
    [87654321] = true  -- ID de tu amigo 2
}

local function isUserPremium()
    return PremiumUsers[game:GetService("Players").LocalPlayer.UserId] == true
end

local Window = OrionLib:MakeWindow({Name = "Equinox Loader", HidePremium = false, SaveConfig = false, ConfigFolder = "LoaderML"})

local Tab = Window:MakeTab({Name = "Scripts", Icon = "", PremiumOnly = false})
Tab:AddSection({Name = "Selecciona tu versión / Select your version"})

-- BOTÓN GRATIS: Configurado con la nueva URL limpia y directa de texto plano
Tab:AddButton({
    Name = "Cargar Script Gratis (Free Hub)",
    Callback = function()
        OrionLib:Destroy()
        task.wait(0.5)
        -- URL definitiva apuntando al archivo renombrado como script.lua
        loadstring(game:HttpGet("https://raw.githubusercontent.com/equinox659/Equinox-hub-muscle-legends/refs/heads/main/script.lua"))()
    end
})

-- BOTÓN PREMIUM: Controla accesos y avisa el estado WIP
Tab:AddButton({
    Name = "Vip hub",
    Callback = function()
        if isUserPremium() then
            OrionLib:MakeNotification({
                Name = "WIP (In progress)",
                Content = "The vip version is in progress",
                Time = 5
            })
        else
            OrionLib:MakeNotification({
                Name = "Acceso Denegado / Access Denied",
                Content = "No tienes acceso al script premium. / You do not have access.",
                Time = 5
            })
        end
    end
})

OrionLib:Init()
